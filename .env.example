# The domain configured for inbound email at your provider, without the @.
MAIL_DOMAIN=yourdomain.com
# Resend API key. Keep private; never commit your real key.
RESEND_API_KEY=re_your_api_key
# Webhook signing secret shown in the Resend dashboard (starts with whsec_).
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret
# Optional app gate. Set a long random password before exposing this site publicly.
APP_PASSWORD=
PORT=3000
