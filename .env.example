# Virtual Email Server - Environment Configuration

# Authentication
# Set ADMIN_PASSWORD to protect the web inbox UI (leave blank to disable login)
ADMIN_PASSWORD=adminpassword123

# Set API_KEY to require X-API-Key header for REST API endpoints
API_KEY=prod-api-key-secret-9941

# Flask session encryption key
SECRET_KEY=change-this-to-a-secure-random-secret-key

# SMTP Server Settings
SMTP_HOST=0.0.0.0
# Use 25 for production internet mail, or 1025 for local non-root testing
SMTP_PORT=1025
MAX_EMAIL_SIZE_MB=10

# Web Dashboard & API Port
WEB_PORT=5000

# Persistence & Retention
# Optional: Set PostgreSQL connection string (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:pass@localhost:5432/maildb
RETENTION_DAYS=30
